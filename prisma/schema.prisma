generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Business {
  id                   String        @id @default(cuid())
  name                 String
  businessType         String
  currency             String        @default("NGN")
  contactInfo          String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  deletedAt            DateTime?
  /// When the scheduled purge of this business runs. Set when the last owner
  /// of the business schedules their account for deletion.
  deletionScheduledFor DateTime?
  branches             Branch[]
  subscription         Subscription?
  users                User[]

  @@index([deletedAt])
}

model Branch {
  id             String         @id @default(cuid())
  businessId     String
  name           String
  address        String?
  contactInfo    String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  business       Business       @relation(fields: [businessId], references: [id])
  branchAccess   BranchAccess[]
  customers      Customer[]
  expenseEntries ExpenseEntry[]
  incomeEntries  IncomeEntry[]
  invoices       Invoice[]
  stockItems     StockItem[]
}

model User {
  id                         String                 @id @default(cuid())
  email                      String                 @unique
  passwordHash               String
  role                       Role
  businessId                 String
  createdAt                  DateTime               @default(now())
  updatedAt                  DateTime               @updatedAt
  emailVerifiedAt            DateTime?
  bannedAt                   DateTime?
  lockedUntil                DateTime?
  /// Set when the account is scheduled for deletion. The account is closed
  /// immediately; the rows are purged after the grace period.
  deletedAt                  DateTime?
  deletionCancelTokenExpires DateTime?
  /// Hash of the one-time token that lets the owner cancel the deletion
  /// during the grace period. The raw token only exists in the email.
  deletionCancelTokenHash    String?
  /// When the scheduled purge of this account runs.
  deletionScheduledFor       DateTime?
  /// Set when the user completes (or skips) the onboarding education flow.
  onboardingCompletedAt      DateTime?
  auditLogEntries            AuditLog[]
  branchAccess               BranchAccess[]
  emailVerification          EmailVerificationCode?
  passwordResetToken         PasswordResetToken?
  payrollEntries             PayrollEntry[]
  sessions                   Session[]
  supportMessages            SupportMessage[]
  business                   Business               @relation(fields: [businessId], references: [id])

  @@index([deletedAt])
}

/// A login session. The browser holds a random token; only its SHA-256 hash
/// is stored here, so a leaked table cannot be replayed as a live session.
model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model BranchAccess {
  id        String   @id @default(cuid())
  userId    String
  branchId  String
  createdAt DateTime @default(now())
  branch    Branch   @relation(fields: [branchId], references: [id])
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, branchId])
}

model PlatformUser {
  id                        String            @id @default(cuid())
  email                     String            @unique
  passwordHash              String
  canAccessAdminConsole     Boolean           @default(true)
  canAccessFounderDashboard Boolean           @default(true)
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt
  sessions                  PlatformSession[]
}

model PlatformSession {
  id             String       @id @default(cuid())
  platformUserId String
  tokenHash      String       @unique
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  platformUser   PlatformUser @relation(fields: [platformUserId], references: [id], onDelete: Cascade)

  @@index([platformUserId])
  @@index([expiresAt])
}

model Customer {
  id            String        @id @default(cuid())
  branchId      String
  name          String
  contact       String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  branch        Branch        @relation(fields: [branchId], references: [id])
  incomeEntries IncomeEntry[]
  invoices      Invoice[]
}

model StockItem {
  id               String          @id @default(cuid())
  branchId         String
  name             String
  sku              String?
  quantity         Int
  costPrice        Decimal         @db.Decimal(14, 2)
  sellingPrice     Decimal         @db.Decimal(14, 2)
  reorderThreshold Int
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  invoiceItems     InvoiceItem[]
  branch           Branch          @relation(fields: [branchId], references: [id])
  stockMovements   StockMovement[]

  @@index([branchId])
}

model StockMovement {
  id               String            @id @default(cuid())
  stockItemId      String
  type             StockMovementType
  quantity         Int
  reason           String
  relatedInvoiceId String?
  createdAt        DateTime          @default(now())
  stockItem        StockItem         @relation(fields: [stockItemId], references: [id])

  @@index([stockItemId])
}

model Invoice {
  id            String        @id @default(cuid())
  branchId      String
  customerId    String?
  status        InvoiceStatus @default(UNPAID)
  paymentMethod String?
  paymentAmount Decimal?      @db.Decimal(14, 2)
  paymentDate   DateTime?
  total         Decimal       @db.Decimal(14, 2)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  branch        Branch        @relation(fields: [branchId], references: [id])
  customer      Customer?     @relation(fields: [customerId], references: [id])
  items         InvoiceItem[]

  @@index([branchId])
}

model InvoiceItem {
  id          String    @id @default(cuid())
  invoiceId   String
  stockItemId String
  quantity    Int
  price       Decimal   @db.Decimal(14, 2)
  invoice     Invoice   @relation(fields: [invoiceId], references: [id])
  stockItem   StockItem @relation(fields: [stockItemId], references: [id])
}

model IncomeEntry {
  id         String    @id @default(cuid())
  branchId   String
  customerId String?
  amount     Decimal   @db.Decimal(14, 2)
  date       DateTime
  note       String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  branch     Branch    @relation(fields: [branchId], references: [id])
  customer   Customer? @relation(fields: [customerId], references: [id])

  @@index([branchId])
}

model ExpenseEntry {
  id        String   @id @default(cuid())
  branchId  String
  category  String
  amount    Decimal  @db.Decimal(14, 2)
  date      DateTime
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  branch    Branch   @relation(fields: [branchId], references: [id])

  @@index([branchId])
}

model PayrollEntry {
  id           String        @id @default(cuid())
  userId       String?
  payPeriod    String
  salaryAmount Decimal       @db.Decimal(14, 2)
  status       InvoiceStatus @default(UNPAID)
  datePaid     DateTime?
  createdAt    DateTime      @default(now())
  user         User?         @relation(fields: [userId], references: [id])
}

model Subscription {
  id          String   @id @default(cuid())
  businessId  String   @unique
  planName    String   @default("Free (Test Period)")
  price       Decimal  @default(0) @db.Decimal(14, 2)
  renewalDate DateTime
  business    Business @relation(fields: [businessId], references: [id])
}

model SupportMessage {
  id        String   @id @default(cuid())
  userId    String?
  message   String
  createdAt DateTime @default(now())
  resolved  Boolean  @default(false)
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id            String      @id @default(cuid())
  userId        String?
  businessId    String
  branchId      String?
  action        AuditAction
  resourceType  String
  resourceId    String
  previousValue Json?
  newValue      Json?
  metadata      Json?
  createdAt     DateTime    @default(now())
  /// Snapshot of the actor's email, so the entry still names someone after
  /// the account row is gone.
  actorEmail    String?
  user          User?       @relation(fields: [userId], references: [id])

  @@index([businessId])
  @@index([action])
}

model AnalyticsEvent {
  id         String   @id @default(cuid())
  eventType  String
  userId     String?
  businessId String?
  branchId   String?
  sessionId  String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([eventType])
}

/// A password reset link. The email carries the raw token; only its SHA-256
/// hash is stored here, so a leaked table cannot reset anyone's password.
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String   @unique
  tokenHash String   @unique
  expires   DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// An email verification code. The email carries the raw code; only its
/// SHA-256 hash is stored here.
model EmailVerificationCode {
  id        String   @id @default(cuid())
  userId    String   @unique
  codeHash  String
  attempts  Int      @default(0)
  expires   DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Role {
  OWNER
  MANAGER
  STAFF
}

enum InvoiceStatus {
  PAID
  UNPAID
  PARTIAL
}

enum StockMovementType {
  IN
  OUT
}

enum AuditAction {
  INVOICE_CREATED
  INVOICE_UPDATED
  INVOICE_STATUS_CHANGED
  STOCK_MOVEMENT_RECORDED
  PAYROLL_RECORD_CREATED
  PAYROLL_RECORD_UPDATED
  STAFF_CHANGED
  CUSTOMER_RECORD_CHANGED
  ROLE_PERMISSION_CHANGED
  CURRENCY_CORRECTED
  ACCOUNT_DELETION_SCHEDULED
  ACCOUNT_DELETION_CANCELLED
  ACCOUNT_DELETION_PURGED
}
